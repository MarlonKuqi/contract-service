{
  "info": {
    "name": "ContractController",
    "description": "Contract management endpoints (CRUD, filters, aggregations)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "oauth2",
    "oauth2": [
      { "key": "grant_type", "value": "password_credentials", "type": "string" },
      { "key": "accessTokenUrl", "value": "{{keycloakUrl}}/realms/contract-service/protocol/openid-connect/token", "type": "string" },
      { "key": "clientId", "value": "contract-service-local", "type": "string" },
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" },
      { "key": "addTokenTo", "value": "header", "type": "string" },
      { "key": "tokenName", "value": "contract-service", "type": "string" }
    ]
  },
  "variable": [
    {
      "key": "keycloakUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "username",
      "value": "counselor.demo",
      "type": "string"
    },
    {
      "key": "password",
      "value": "counselor",
      "type": "string"
    },
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "clientId",
      "value": "REPLACE_WITH_CLIENT_UUID",
      "type": "string"
    },
    {
      "key": "contractId",
      "value": "REPLACE_WITH_CONTRACT_UUID",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Create Contract - Default Dates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"costAmount\": 1500.50\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/contracts",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "contracts"]
        },
        "description": "Create a contract with default dates. If not provided, startDate defaults to current date and endDate is null (open-ended contract)."
      }
    },
    {
      "name": "Create Contract - With Dates",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"startDate\": \"2025-01-01T00:00:00\",\n  \"endDate\": \"2025-12-31T23:59:59\",\n  \"costAmount\": 2500.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/contracts",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "contracts"]
        },
        "description": "Create a contract with specific start and end dates (ISO 8601 format without timezone - Swiss time assumed)."
      }
    },
    {
      "name": "Create Contract - Open Ended",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"clientId\": \"{{clientId}}\",\n  \"startDate\": \"2025-01-01T00:00:00\",\n  \"endDate\": null,\n  \"costAmount\": 3500.75\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/contracts",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "contracts"]
        },
        "description": "Create an open-ended contract (no end date - Swiss time assumed)."
      }
    },
    {
      "name": "Get Active Contracts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v2/contracts?clientId={{clientId}}&page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "contracts"],
          "query": [
            {
              "key": "clientId",
              "value": "{{clientId}}",
              "description": "UUID of the client (required)"
            },
            {
              "key": "page",
              "value": "0",
              "description": "Page number (starts at 0)"
            },
            {
              "key": "size",
              "value": "20",
              "description": "Number of items per page (default: 20, min: 1, max: 100)"
            }
          ]
        },
        "description": "Get all active contracts for a client (paginated). Returns only contracts where current date < end date (or endDate is null). Default page size is 20, max is 100. Results are always sorted by last modification, most recent first; a sort parameter is ignored. Response format: {content: [...], pageNumber, pageSize, totalElements, totalPages, first, last}"
      }
    },
    {
      "name": "Get Contracts - Filter By Update Date",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v2/contracts?clientId={{clientId}}&updatedSince=2025-10-26T00:00:00&page=0&size=20",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "contracts"],
          "query": [
            {
              "key": "clientId",
              "value": "{{clientId}}",
              "description": "UUID of the client (required)"
            },
            {
              "key": "updatedSince",
              "value": "2025-10-26T00:00:00",
              "description": "Filter contracts by lastModifiedDate (ISO 8601 format without timezone - Swiss time assumed)"
            },
            {
              "key": "page",
              "value": "0",
              "description": "Page number (starts at 0)"
            },
            {
              "key": "size",
              "value": "20",
              "description": "Number of items per page"
            }
          ]
        },
        "description": "Get active contracts updated since a specific date (Swiss time assumed), with pagination support."
      }
    },
    {
      "name": "Get Contract By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v2/contracts/{{contractId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "contracts", "{{contractId}}"]
        },
        "description": "Get a specific contract by its ID. Returns 404 if the contract does not exist."
      }
    },
    {
      "name": "Update Contract Cost",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 3000.00\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/v2/contracts/{{contractId}}/cost",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "contracts", "{{contractId}}", "cost"]
        },
        "description": "Update the cost amount of a contract and its internal last modification date (used by the updatedSince filter). Only active (non-expired) contracts can be updated: an expired contract returns 409 with code contractExpired. A concurrent modification is retried by the server; if the conflict persists after several retries, it returns 409 with code optimisticLockFailure. An invalid amount returns 422. Sending the same amount (scale-insensitive, e.g. 100.0 = 100.00) is a no-op: the contract is not modified."
      }
    },
    {
      "name": "Get Total of Active Contracts",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/v2/contracts/total?clientId={{clientId}}",
          "host": ["{{baseUrl}}"],
          "path": ["v2", "contracts", "total"],
          "query": [
            {
              "key": "clientId",
              "value": "{{clientId}}",
              "description": "UUID of the client (required)"
            }
          ]
        },
        "description": "Very performant endpoint using database aggregation. Returns the total of costAmount for all active contracts of a client."
      }
    }
  ]
}

